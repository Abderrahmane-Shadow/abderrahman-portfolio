# ==============================================================================
# SUPABASE CONFIGURATION FOR ABDERRAHMAN EL HARAKANI PORTFOLIO & CMS
# ==============================================================================
# 1. Create a free Supabase project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and Anon Public Key into your private .env.local file
# 4. In Supabase SQL Editor, run the script provided in: supabase_schema.sql
# 5. You can also configure or update these credentials right from the Admin Dashboard at /admin/settings!

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
